# Choose one: gemini | groq | ollama (free options) or anthropic | openai | azure (paid)
LLM_PROVIDER=gemini

# Free: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Free tier: key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free, runs on your own PC: install Ollama, then `ollama pull llama3.1`
OLLAMA_MODEL=llama3.1


ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=

# Any SQLAlchemy URL. Examples:
# PostgreSQL: postgresql+psycopg2://demo:demo@localhost:5432/shop
# MySQL:      mysql+pymysql://user:password@localhost:3306/shop
# SQLite:     sqlite:///data/sample.db
DB_URL=postgresql+psycopg2://demo:demo@localhost:5432/shop
